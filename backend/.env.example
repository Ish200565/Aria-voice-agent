# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Models (primary -> automatic fallback on rate limit / outage)
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# Voice (Indian English female). Alternatives: en-IN-NeerjaExpressiveNeural, hi-IN-SwaraNeural
TTS_VOICE=en-IN-NeerjaNeural
TTS_RATE=+5%

# Comma-separated frontend origins allowed by CORS ("*" for local dev)
ALLOWED_ORIGINS=*

# Free-tier protection
MAX_TURNS=20
MAX_CALL_SECONDS=300
MAX_HISTORY_MESSAGES=16
MAX_TOKENS=150
